#!/bin/sh
# zenshell - abre una shell interactiva dentro del pack de ejercicios activo.
#
#   zenshell         shell en la raiz del pack
#   zenshell repo    shell en <pack>/repo (si no existe, cae a la raiz del pack)
#
# Lo usan el panel izquierdo (tras elegir pack) y el inferior derecho del layout.
# A mano sirve para volver al pack despues de cambiarlo; para moverte sin
# reemplazar la shell tienes `zcd`.
sub=${1-}

if ! pack=$(zenpack --print 2>/dev/null); then
    pack="${ZENIDX_ROOT:-$HOME/zenidx}"
fi

if [ -n "$sub" ] && [ -d "$pack/$sub" ]; then
    cd "$pack/$sub" || exit 1
else
    cd "$pack" 2>/dev/null || cd "${ZENIDX_ROOT:-$HOME/zenidx}" || exit 1
fi

exec "${SHELL:-/bin/sh}"
