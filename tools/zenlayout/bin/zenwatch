#!/usr/bin/env bash
# zenwatch - panel de vigilancia del layout: repite un comando dentro del pack
# de ejercicios activo y, al cortarlo con Ctrl+C, deja una shell viva ahi mismo
# en vez de cerrar el panel.
#
#   zenwatch [-n SEGUNDOS] SUBDIR CMD...
#
#   zenwatch -n 2 repo tree -C
#   zenwatch -n 5 repo norminette
#   zenwatch -n 2 test zentest --compact
#
# El comando se relanza en cada vuelta, y como resuelve el pack en ese momento,
# cambiar de pack con `zenpack` reapunta el panel sin reiniciar nada.
set -uo pipefail

interval=2
header=1
while [ $# -gt 0 ]; do
    case $1 in
        -n) interval=${2-2}; shift 2 ;;
        -H|--no-header) header=0; shift ;;
        -h|--help) sed -n '2,15p' "$0" | cut -c3-; exit 0 ;;
        *) break ;;
    esac
done

[ $# -ge 2 ] || { sed -n '2,14p' "$0" | cut -c3-; exit 2; }

sub=$1; shift

# `watch -c` respeta el color aunque la salida no sea un tty; zentest lo mira.
export FORCE_COLOR=1
# Cabecera con el pack activo, para saber siempre sobre que se esta mirando.
# -H la quita en los paneles cuyo comando ya imprime la suya (zentest).
[ "$header" = "1" ] && export ZENIN_HEADER=1

# Trap con comando (no con "") para que el hijo herede el manejo por defecto:
# Ctrl+C mata el watch, esta shell sobrevive y sigue a la linea siguiente.
trap ':' INT

watch -c -n "$interval" "$(printf '%q ' zenin "$sub" "$@")"

# Ctrl+C (o salida del watch): shell interactiva donde estaba mirando.
if pack=$(zenpack --print 2>/dev/null); then
    cd "$pack/$sub" 2>/dev/null || cd "$pack" 2>/dev/null || cd "$HOME"
else
    cd "${ZENIDX_ROOT:-$HOME/zenidx}" 2>/dev/null || cd "$HOME"
fi
printf '\n%s\n' "watch parado. Estas en $(pwd). Relanzalo con: zenwatch -n $interval $sub $*"
exec "${SHELL:-/bin/bash}"
