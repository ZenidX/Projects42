# ~/.zshenv - se lee en TODA invocacion de zsh, tambien en las no interactivas
# (`zsh -c ...`), al reves que ~/.zshrc. El PATH vive aqui para que los paneles
# de Terminator, los scripts y los cron encuentren ~/.local/bin y ~/local/bin.
#
# El guard evita que el PATH se duplique en shells anidadas.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
    *":$HOME/local/bin:"*) ;;
    *) export PATH="$HOME/local/bin:$PATH" ;;
esac
