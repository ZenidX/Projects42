[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    # --- reparto horizontal: columna A | (columna B | columna C) ---
    [[[child1]]]
      type = HPaned
      parent = window0
      order = 0
      ratio = 0.42
    # ============ columna A: 1 panel ============
    [[[terminal1]]]
      type = Terminal
      parent = child1
      order = 0
      profile = default
      title = pack
      directory = @ZENIDX@
      command = zenpack; command -v zenshell >/dev/null && exec zenshell repo || exec $SHELL
    [[[child2]]]
      type = HPaned
      parent = child1
      order = 1
      ratio = 0.45
    # ============ columna B: 3 paneles de vigilancia ============
    [[[child3]]]
      type = VPaned
      parent = child2
      order = 0
      ratio = 0.333
    [[[terminal2]]]
      type = Terminal
      parent = child3
      order = 0
      profile = default
      title = tree
      directory = @ZENIDX@
      command = exec zenwatch -n @N_TREE@ repo tree -C
    [[[child4]]]
      type = VPaned
      parent = child3
      order = 1
      ratio = 0.5
    [[[terminal3]]]
      type = Terminal
      parent = child4
      order = 0
      profile = default
      title = norminette
      directory = @ZENIDX@
      command = exec zenwatch -n @N_NORM@ repo norminette
    [[[terminal4]]]
      type = Terminal
      parent = child4
      order = 1
      profile = default
      title = tests
      directory = @ZENIDX@
      command = exec zenwatch -H -n @N_TEST@ test zentest --compact
    # ============ columna C: 2 paneles ============
    [[[child5]]]
      type = VPaned
      parent = child2
      order = 1
      ratio = 0.666
    [[[terminal5]]]
      type = Terminal
      parent = child5
      order = 0
      profile = default
      title = @ASSIST_TITLE@
      directory = @ZENIDX@
      command = @CMD_ASSIST@
    [[[terminal6]]]
      type = Terminal
      parent = child5
      order = 1
      profile = default
      title = shell del pack
      directory = @ZENIDX@
      command = command -v zenshell >/dev/null && exec zenshell || exec $SHELL
  # ============================================================
  # focus: sin panel de asistente, para pantallas pequenas o
  # para quien no tenga `claude` instalado. 4 paneles.
  # ============================================================
  [[focus]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = HPaned
      parent = window0
      order = 0
      ratio = 0.35
    [[[terminal1]]]
      type = Terminal
      parent = child1
      order = 0
      profile = default
      title = pack
      directory = @ZENIDX@
      command = zenpack; command -v zenshell >/dev/null && exec zenshell repo || exec $SHELL
    [[[child2]]]
      type = VPaned
      parent = child1
      order = 1
      ratio = 0.333
    [[[terminal2]]]
      type = Terminal
      parent = child2
      order = 0
      profile = default
      title = tree
      directory = @ZENIDX@
      command = exec zenwatch -n @N_TREE@ repo tree -C
    [[[child3]]]
      type = VPaned
      parent = child2
      order = 1
      ratio = 0.5
    [[[terminal3]]]
      type = Terminal
      parent = child3
      order = 0
      profile = default
      title = norminette
      directory = @ZENIDX@
      command = exec zenwatch -n @N_NORM@ repo norminette
    [[[terminal4]]]
      type = Terminal
      parent = child3
      order = 1
      profile = default
      title = tests
      directory = @ZENIDX@
      command = exec zenwatch -H -n @N_TEST@ test zentest --compact
  # ============================================================
  # tests: solo el panel de tests, a pantalla completa.
  # ============================================================
  [[tests]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[terminal1]]]
      type = Terminal
      parent = window0
      profile = default
      title = tests
      directory = @ZENIDX@
      command = exec zenwatch -H -n @N_TEST@ test zentest
  # ============================================================
  # solo: una terminal suelta dentro del pack. `terminator -l solo`
  # ============================================================
  [[solo]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
      directory = @ZENIDX@
