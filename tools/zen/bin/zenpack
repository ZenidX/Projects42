#!/usr/bin/env bash
# zenpack - elige (o crea) el pack de ejercicios sobre el que se trabaja.
#
#   zenpack              menu interactivo: primero la etapa, luego el pack
#   zenpack 005_c03      selecciona un pack por nombre o por etapa/nombre
#   zenpack c03          vale tambien el nombre sin el numero...
#   zenpack 005          ...o el numero suelto
#   zenpack -p           imprime la ruta del pack actual (vacio + salida 1 si no hay)
#   zenpack -n           va directo a crear un pack nuevo
#
# La eleccion se guarda en ~/.local/state/zenidx/current-pack y la leen los
# demas paneles del layout (zenin, zentest, zcd), asi que cambiar de pack aqui
# los reapunta a todos sin reiniciar nada.
#
# La funcion de shell del mismo nombre (shell/zenidx.sh) envuelve este script y
# ademas deja la shell en <pack>/repo despues de elegir.
#
# Un pack es un directorio ETAPA/NNN_nombre bajo ~/zenidx/packs, con repo/,
# test/, subject.pdf y extra/. La etapa es el tramo de 42 (piscine, cursus) y el
# numero, de 000 a 999, es el orden en que se hacen los proyectos, que no es el
# alfabetico.
#
# Una etapa con muchos proyectos por delante se parte en milestones, cada uno en
# su directorio: ETAPA/MN/NNN_nombre (cursus/M1/100_ft_printf). Los titulos salen
# de ETAPA/.milestones y el menu pregunta primero por ahi en vez de soltar la
# lista entera.
set -euo pipefail

ROOT="${ZENIDX_ROOT:-$HOME/zenidx/packs}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/zenidx"
STATE_FILE="$STATE_DIR/current-pack"

if [ -t 1 ]; then
    B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; C=$'\033[36m'; R=$'\033[0m'
else
    B=''; D=''; G=''; Y=''; C=''; R=''
fi

usage() { sed -n '2,26p' "$0" | cut -c3- ; }

# --- numeracion ------------------------------------------------------------
# El prefijo NNN_ ordena los packs dentro de su etapa. Estas dos son las que
# saben leerlo; el resto del script trata el nombre como una cadena cualquiera,
# asi que un pack sin numerar sigue funcionando igual que siempre.

num_of()    { case $1 in [0-9][0-9][0-9]_*) printf '%s' "${1%%_*}" ;; esac; }
strip_num() { printf '%s' "${1#[0-9][0-9][0-9]_}"; }

# --- milestones ------------------------------------------------------------
# Una etapa larga se parte en milestones, uno por directorio: ETAPA/M0, M1...
# hasta M9, con sus packs dentro. Los titulos salen de ETAPA/.milestones, una
# linea "N = titulo" por milestone, y la numeracion sigue la centena del
# milestone (M1 -> 100, 101...) para que el numero no se repita en la etapa y
# `zenpack 100` siga siendo un nombre unico.
#
# Sin milestones la etapa no se parte y se lista entera, que es lo que le va a
# piscine (20 packs de tiron). El cursus si los usa: con el common core completo
# la lista plana pasa de 50 packs y elegir se vuelve buscar con la vista.

is_mdir()        { case $1 in M[0-9]) return 0 ;; *) return 1 ;; esac; }

has_milestones() {
    local d
    [ -r "$ROOT/$1/.milestones" ] && return 0
    for d in "$ROOT/$1"/M[0-9]/; do [ -d "$d" ] && return 0; done
    return 1
}

band_of() {
    local n
    n=$(num_of "$1")
    [ -n "$n" ] || return 1
    printf '%d' "$((10#$n / 100))"
}

# La etapa es siempre el primer tramo bajo ROOT, este el pack un nivel o dos
# por debajo.
etapa_of() { local r=${1#"$ROOT"/}; printf '%s' "${r%%/*}"; }

# El milestone de un pack es el directorio MN que lo contiene. Un pack suelto
# en una etapa con milestones (de antes de partirla) cae por su centena.
milestone_of() {
    local parent
    parent=$(basename "$(dirname "$1")")
    if is_mdir "$parent"; then
        printf '%s' "${parent#M}"
    else
        band_of "$(basename "$1")"
    fi
}

milestone_title() {
    local cat=$1 want=$2 line key
    [ -r "$ROOT/$cat/.milestones" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in ''|\#*) continue ;; esac
        key=${line%%=*}
        key=${key//[[:space:]]/}
        case $key in ''|*[!0-9]*) continue ;; esac
        [ "$((10#$key))" -eq "$want" ] || continue
        line=${line#*=}
        line=${line#"${line%%[![:space:]]*}"}
        printf '%s' "${line%"${line##*[![:space:]]}"}"
        return 0
    done < "$ROOT/$cat/.milestones"
    return 1
}

list_milestones() {
    local cat=$1 line key
    [ -r "$ROOT/$cat/.milestones" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in ''|\#*) continue ;; esac
        key=${line%%=*}
        key=${key//[[:space:]]/}
        case $key in ''|*[!0-9]*) continue ;; esac
        printf '   %s%s%s) %s\n' "$C" "$key" "$R" "$(milestone_title "$cat" "$((10#$key))")"
    done < "$ROOT/$cat/.milestones"
}

# La clave de grupo de un pack: su etapa, o etapa:N si la etapa usa milestones.
group_of() {
    local cat b
    cat=$(etapa_of "$1")
    if has_milestones "$cat" && b=$(milestone_of "$1"); then
        printf '%s:%s' "$cat" "$b"
    else
        printf '%s' "$cat"
    fi
}

group_label() {
    local cat=${1%%:*} n t
    case $1 in
        *:*) n=${1#*:}
             if t=$(milestone_title "$cat" "$n"); then
                 printf '%s · %s' "$cat" "$t"
             else
                 printf '%s · milestone %s' "$cat" "$n"
             fi ;;
        *)   printf '%s' "$cat" ;;
    esac
}

# Los packs llegan ordenados por ruta, asi que cada grupo viene de una pieza;
# el awk es por si algun dia dejan de venirlo.
group_keys() {
    local p
    for p in "$@"; do
        group_of "$p"
        printf '\n'
    done | awk 'NF && !seen[$0]++'
}

packs_in_group() {
    local key=$1 p
    shift
    for p in "$@"; do
        if [ "$(group_of "$p")" = "$key" ]; then printf '%s\n' "$p"; fi
    done
}

# --- estado ----------------------------------------------------------------

current_pack() {
    [ -r "$STATE_FILE" ] || return 1
    local p
    p=$(< "$STATE_FILE")
    [ -n "$p" ] && [ -d "$p" ] || return 1
    printf '%s\n' "$p"
}

set_pack() {
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" > "$STATE_FILE"
    printf '%sPack actual:%s %s\n' "$B" "$R" "${1#$ROOT/}"
}

# --- inventario ------------------------------------------------------------

# Un nivel por debajo de la etapa estan los packs, salvo los directorios MN,
# que son milestones y tienen los packs un nivel mas abajo.
list_packs() {
    local cat pack sub
    for cat in "$ROOT"/*/; do
        for pack in "$cat"*/; do
            [ -d "$pack" ] || continue
            if is_mdir "$(basename "$pack")"; then
                for sub in "$pack"*/; do
                    [ -d "$sub" ] && printf '%s\n' "${sub%/}"
                done
            else
                printf '%s\n' "${pack%/}"
            fi
        done
    done
}

list_categories() {
    local cat
    for cat in "$ROOT"/*/; do
        [ -d "$cat" ] && printf '%s\n' "$(basename "${cat%/}")"
    done
}

# Resumen de que contiene un pack, para orientarse en el menu.
pack_bits() {
    local p=$1 bits='' n
    if [ -d "$p/repo" ]; then
        n=$(find "$p/repo" -maxdepth 1 -type d -name 'ex*' | wc -l)
        [ "$n" -gt 0 ] && bits="repo(${n}ex)" || bits="repo"
    fi
    [ -d "$p/test" ] && bits="$bits test"
    compgen -G "$p/*subject*.pdf" > /dev/null 2>&1 && bits="$bits subject"
    [ -d "$p/extra" ] && bits="$bits extra"
    [ -n "$bits" ] && printf '%s' "$bits" || printf '%s' '-'
}

# --- creacion --------------------------------------------------------------

valid_name() {
    case $1 in
        ''|*/*|.*) return 1 ;;
        *) [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] ;;
    esac
}

# El Makefile de test/ es identico en todos los packs, asi que el pack nuevo
# hereda el del pack mas reciente que tenga uno. En una instalacion recien
# hecha todavia no hay ninguno, y entonces se usa la plantilla que deja
# install.sh en ~/.local/share/zenidx.
seed_test_dir() {
    local dest=$1 src tpl p
    # Se miran solo los test/ de los packs: un find a ciegas por profundidad
    # se colaria en subdirectorios de un pack (001_Libft/albektur/test).
    src=$(list_packs | while IFS= read -r p; do
              [ "$p" = "$dest" ] && continue
              if [ -f "$p/test/Makefile" ]; then stat -c '%Y %n' "$p/test/Makefile"; fi
          done | sort -rn | head -1 | cut -d' ' -f2-)
    if [ -n "$src" ]; then
        cp "$src" "$dest/test/Makefile"
        printf '  %sMakefile de test copiado de %s%s\n' "$D" "${src#$ROOT/}" "$R"
        return
    fi
    tpl="${XDG_DATA_HOME:-$HOME/.local/share}/zenidx/test/Makefile"
    if [ -r "$tpl" ]; then
        cp "$tpl" "$dest/test/Makefile"
        printf '  %sMakefile de test copiado de la plantilla%s\n' "$D" "$R"
    fi
}

# El siguiente numero libre, para no ir mirando a mano por donde iba la cuenta.
# Con milestone, dentro de su centena (el 2 va de 200 a 299); sin el, en toda la
# etapa. Una etapa vacia (o recien inventada) empieza en 000; una que ya existe
# y no usa numeros no se numera a la fuerza.
next_prefix() {
    local cat=$1 band=${2-} p b n max=-1 any=0 lo=0 hi=999
    if [ -n "$band" ]; then lo=$((band * 100)); hi=$((lo + 99)); fi
    while IFS= read -r p; do
        [ "$(etapa_of "$p")" = "$cat" ] || continue
        any=1
        b=$(basename "$p")
        n=$(num_of "$b")
        [ -n "$n" ] || continue
        n=$((10#$n))
        { [ "$n" -ge "$lo" ] && [ "$n" -le "$hi" ]; } || continue
        [ "$n" -gt "$max" ] && max=$n
    done < <(list_packs)
    if [ "$max" -ge 0 ]; then
        [ "$max" -lt "$hi" ] || return 1
        printf '%03d' "$((max + 1))"
    elif [ -n "$band" ] || [ "$any" -eq 0 ]; then
        printf '%03d' "$lo"
    else
        return 1
    fi
}

create_pack() {
    local cats cat name pack rel i prefix band
    mapfile -t cats < <(list_categories)

    printf '\n%sCrear un pack nuevo%s\n\n' "$B" "$R"
    printf '  Categorias existentes:\n'
    for i in "${!cats[@]}"; do
        printf '   %s%2d%s) %s\n' "$C" "$((i + 1))" "$R" "${cats[$i]}"
    done
    printf '\n'
    read -r -p "  Categoria (numero, o un nombre nuevo): " cat \
        || { printf '\n  %scancelado%s\n' "$Y" "$R"; return 1; }
    [ -n "$cat" ] || { printf '  %scancelado%s\n' "$Y" "$R"; return 1; }
    if [[ $cat =~ ^[0-9]+$ ]]; then
        [ "$cat" -ge 1 ] && [ "$cat" -le "${#cats[@]}" ] \
            || { printf '  %sno hay categoria %s%s\n' "$Y" "$cat" "$R"; return 1; }
        cat=${cats[$((cat - 1))]}
    fi
    valid_name "$cat" || { printf '  %snombre de categoria no valido%s\n' "$Y" "$R"; return 1; }

    # En una etapa con milestones el numero sale de la centena que le toque, asi
    # que hay que saber en cual cae antes de proponerlo.
    band=''
    if has_milestones "$cat"; then
        printf '\n  Milestones de %s%s%s:\n' "$B" "$cat" "$R"
        list_milestones "$cat"
        printf '\n'
        read -r -p "  Milestone (numero): " band \
            || { printf '\n  %scancelado%s\n' "$Y" "$R"; return 1; }
        case $band in
            ''|*[!0-9]*) printf '  %smilestone no valido%s\n' "$Y" "$R"; return 1 ;;
        esac
        band=$((10#$band))
        [ "$band" -le 9 ] || { printf '  %sel milestone va de 0 a 9%s\n' "$Y" "$R"; return 1; }
    fi

    prefix=$(next_prefix "$cat" "$band") || prefix=''
    if [ -n "$prefix" ]; then
        read -r -p "  Nombre del pack (se le pone el prefijo ${prefix}_): " name \
            || { printf '\n  %scancelado%s\n' "$Y" "$R"; return 1; }
    else
        read -r -p "  Nombre del pack: " name \
            || { printf '\n  %scancelado%s\n' "$Y" "$R"; return 1; }
    fi
    valid_name "$name" || { printf '  %snombre de pack no valido%s\n' "$Y" "$R"; return 1; }
    # Si escribes tu el numero (para meter uno intercalado, o para repetir el de
    # la intra) manda el tuyo.
    if [ -n "$prefix" ] && [ -z "$(num_of "$name")" ]; then
        name="${prefix}_$name"
    fi

    rel="$cat/$name"
    [ -n "$band" ] && rel="$cat/M$band/$name"
    pack="$ROOT/$rel"
    [ -e "$pack" ] && { printf '  %sya existe %s%s\n' "$Y" "$rel" "$R"; return 1; }

    mkdir -p "$pack"/{repo,test,extra}
    printf '\n  %screado%s %s%s%s  (repo/ test/ extra/)\n' "$G" "$R" "$B" "$rel" "$R"
    seed_test_dir "$pack"
    printf '  %sfalta clonar el repo en %s/repo y dejar el subject.pdf%s\n\n' \
           "$D" "$rel" "$R"

    set_pack "$pack"
}

# --- menu ------------------------------------------------------------------

# Dos pasos: primero el grupo (la etapa, o el milestone dentro de ella) y luego
# sus packs. Con el common core entero por delante, una sola lista numerada se
# va a mas de cincuenta lineas y elegir se convierte en buscar con la vista.
# Cuando solo hay un grupo el primer paso se salta: no hay nada que elegir.
menu() {
    local packs keys labels counts sel cur key lbl i n choice w
    mapfile -t packs < <(list_packs)
    cur=$(current_pack 2>/dev/null || true)

    if [ "${#packs[@]}" -eq 0 ]; then
        printf '%sNo hay ningun pack en %s todavia.%s\n' "$Y" "$ROOT" "$R"
        create_pack
        return
    fi

    mapfile -t keys < <(group_keys "${packs[@]}")
    labels=(); counts=(); w=0
    for key in "${keys[@]}"; do
        lbl=$(group_label "$key")
        labels+=("$lbl")
        n=$(packs_in_group "$key" "${packs[@]}" | wc -l)
        if [ "$n" -eq 1 ]; then counts+=("1 pack"); else counts+=("$n packs"); fi
        [ "${#lbl}" -gt "$w" ] && w=${#lbl}
    done

    while :; do
        if [ "${#keys[@]}" -eq 1 ]; then
            key=${keys[0]}
        else
            printf '\n%sPacks de ejercicios%s %sen %s%s\n\n' "$B" "$R" "$D" "$ROOT" "$R"
            for i in "${!keys[@]}"; do
                if [ -n "$cur" ] && [ "$(group_of "$cur")" = "${keys[$i]}" ]; then
                    printf '   %s%2d%s) %s%-*s%s %s%8s%s %s<- actual%s\n' \
                        "$C" "$((i + 1))" "$R" "$B" "$w" "${labels[$i]}" "$R" \
                        "$D" "${counts[$i]}" "$R" "$G" "$R"
                else
                    printf '   %s%2d%s) %-*s %s%8s%s\n' \
                        "$C" "$((i + 1))" "$R" "$w" "${labels[$i]}" \
                        "$D" "${counts[$i]}" "$R"
                fi
            done
            printf '\n    %sn%s) crear un pack nuevo\n' "$C" "$R"
            printf '    %sq%s) salir sin tocar nada\n\n' "$C" "$R"

            if ! read -r -p "Etapa [1-${#keys[@]}/n/q]: " choice; then
                printf '\n%ssin cambios. Vuelve a elegir cuando quieras con `zenpack`.%s\n' "$D" "$R"
                return 0
            fi
            case $choice in
                ''|q|Q)   printf '%ssin cambios%s\n' "$D" "$R"; return 0 ;;
                n|N)      create_pack; return $? ;;
                *[!0-9]*) printf '%sopcion no valida%s\n' "$Y" "$R"; return 1 ;;
            esac
            if [ "$choice" -lt 1 ] || [ "$choice" -gt "${#keys[@]}" ]; then
                printf '%sno hay opcion %s%s\n' "$Y" "$choice" "$R"
                return 1
            fi
            key=${keys[$((choice - 1))]}
        fi

        mapfile -t sel < <(packs_in_group "$key" "${packs[@]}")
        # La columna se ajusta al nombre mas largo del grupo: con los packs
        # numerados (000_C-piscine-reloaded) un ancho fijo de 10 partia la linea.
        n=10
        for i in "${!sel[@]}"; do
            lbl=$(basename "${sel[$i]}")
            [ "${#lbl}" -gt "$n" ] && n=${#lbl}
        done

        printf '\n  %s%s%s\n\n' "$B" "$(group_label "$key")" "$R"
        for i in "${!sel[@]}"; do
            if [ "${sel[$i]}" = "$cur" ]; then
                printf '   %s%2d%s) %s%-*s%s %s%s%s %s<- actual%s\n' \
                    "$C" "$((i + 1))" "$R" "$B" "$n" "$(basename "${sel[$i]}")" "$R" \
                    "$D" "$(pack_bits "${sel[$i]}")" "$R" "$G" "$R"
            else
                printf '   %s%2d%s) %-*s %s%s%s\n' \
                    "$C" "$((i + 1))" "$R" "$n" "$(basename "${sel[$i]}")" \
                    "$D" "$(pack_bits "${sel[$i]}")" "$R"
            fi
        done

        printf '\n    %sn%s) crear un pack nuevo\n' "$C" "$R"
        [ "${#keys[@]}" -gt 1 ] && printf '    %sv%s) volver a las etapas\n' "$C" "$R"
        printf '    %sq%s) salir sin tocar nada\n\n' "$C" "$R"

        if ! read -r -p "Pack [1-${#sel[@]}/n/q]: " choice; then
            printf '\n%ssin cambios. Vuelve a elegir cuando quieras con `zenpack`.%s\n' "$D" "$R"
            return 0
        fi
        case $choice in
            ''|q|Q)   printf '%ssin cambios%s\n' "$D" "$R"; return 0 ;;
            n|N)      create_pack; return $? ;;
            v|V)      if [ "${#keys[@]}" -eq 1 ]; then
                          printf '%ssin cambios%s\n' "$D" "$R"; return 0
                      fi
                      continue ;;
            *[!0-9]*) printf '%sopcion no valida%s\n' "$Y" "$R"; return 1 ;;
        esac
        if [ "$choice" -ge 1 ] && [ "$choice" -le "${#sel[@]}" ]; then
            set_pack "${sel[$((choice - 1))]}"
            return 0
        fi
        printf '%sno hay opcion %s%s\n' "$Y" "$choice" "$R"
        return 1
    done
}

# --- seleccion directa por nombre ------------------------------------------

# Dos pasadas. Primero el nombre tal cual; si nada casa, se prueba otra vez
# perdonando el prefijo numerico, para que `zenpack c09` y `zenpack 011` sigan
# llevando a 011_c09 sin teclear el nombre entero. El orden importa: un pack
# que casa exacto gana, y solo si no hay ninguno se abre la mano.
resolve() {
    local want=$1 packs match=() p b cat n
    mapfile -t packs < <(list_packs)
    for p in "${packs[@]}"; do
        if [ "${p#$ROOT/}" = "$want" ] || [ "$(basename "$p")" = "$want" ] || [ "$p" = "$want" ] \
           || [ "$(etapa_of "$p")/$(basename "$p")" = "$want" ]; then
            match+=("$p")
        fi
    done
    if [ "${#match[@]}" -eq 0 ]; then
        for p in "${packs[@]}"; do
            b=$(basename "$p")
            cat=$(etapa_of "$p")
            if [ "$(strip_num "$b")" = "$want" ] \
               || [ "$cat/$(strip_num "$b")" = "$want" ] \
               || { n=$(num_of "$b"); [ -n "$n" ] && { [ "$n" = "$want" ] || [ "$cat/$n" = "$want" ]; }; }; then
                match+=("$p")
            fi
        done
    fi
    case "${#match[@]}" in
        1) printf '%s\n' "${match[0]}" ;;
        0) printf 'zenpack: no encuentro el pack "%s"\n' "$want" >&2; return 1 ;;
        *) printf 'zenpack: "%s" es ambiguo: %s\n' "$want" "${match[*]#$ROOT/}" >&2; return 1 ;;
    esac
}

# --- entrada ---------------------------------------------------------------

case "${1-}" in
    -h|--help)  usage; exit 0 ;;
    -p|--print) current_pack || exit 1; exit 0 ;;
    -n|--new)   create_pack; exit $? ;;
    '')         menu; exit $? ;;
    -*)         usage >&2; exit 2 ;;
    *)          pack=$(resolve "$1") || exit 1
                set_pack "$pack"; exit 0 ;;
esac
