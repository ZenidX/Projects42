#!/usr/bin/env bash
# zengit - git para los repos de entrega (vogsphere) de los packs.
#
#   zengit init [dir]                   da de alta un repo de entrega nuevo
#   zengit remote add origin <url>      lo enchufa al repo de vogsphere
#   zengit status|add|commit|push|...   cualquier subcomando de git
#   zengit -l                           lista los repos gestionados y su estado
#   zengit -h                           esta ayuda
#
# El .git de cada repo de vogsphere NO vive dentro del arbol de trabajo: se
# guarda en ~/.local/share/zenidx-vogsphere/<slug>.git con core.worktree
# apuntando de vuelta al pack. Asi el repo de zenidx puede versionar los
# ficheros de los ejercicios como ficheros normales en vez de como un gitlink
# (un puntero vacio), y las entregas a vogsphere siguen funcionando igual.
#
# Uso normal: te situas dentro del pack (o de su repo/) y llamas a zengit.
# Para dar de alta uno nuevo, crea el directorio y llama a init desde el pack:
#
#   mkdir -p ~/zenidx/packs/cursus/000_C-piscine-reloaded/repo
#   cd ~/zenidx/packs/cursus/000_C-piscine-reloaded && zengit init
#   zengit remote add origin vogsphere@vogsphere.42<campus>.com:vogsphere/<id>
#
# OJO: el slug sale de la ruta, asi que renombrar o mover un pack deja su
# git-dir huerfano. Hay que renombrar el .git del store igual y reapuntar su
# core.worktree (`git --git-dir=... config core.worktree <ruta nueva>`).
set -euo pipefail

ROOT="${ZENIDX_ROOT:-$HOME/zenidx/packs}"
STORE="${ZENIDX_VOGSPHERE:-$HOME/.local/share/zenidx-vogsphere}"

if [ -t 1 ]; then
    B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'
else
    B=''; D=''; R=''
fi

# packs/piscine/005_c03/repo -> piscine-005_c03 ; packs/cursus/000_X -> cursus-000_X
slug_for() {
    printf '%s' "${1#"$ROOT"/}" | sed 's|/repo$||; s|/|-|g'
}

list_repos() {
    local gd slug wt
    for gd in "$STORE"/*.git; do
        [ -d "$gd" ] || continue
        slug=$(basename "$gd" .git)
        wt=$(git --git-dir="$gd" config --get core.worktree || echo '?')
        printf '%s%-18s%s %s%s%s\n' "$B" "$slug" "$R" "$D" "${wt/#$HOME/\~}" "$R"
    done
}

# Da de alta un repo de entrega: crea el git-dir en el store y lo apunta al
# arbol de trabajo. Sin argumento parte del directorio actual; si ese tiene un
# repo/ dentro es ese el que se registra, que es donde viven los ejercicios y
# lo que slug_for da por supuesto (<pack>/repo y <pack> dan el mismo
# slug, asi que el worktree hay que elegirlo aqui de forma explicita).
init_repo() {
    local dir wt slug gitdir

    if ! dir=$(cd "${1:-.}" 2>/dev/null && pwd -P); then
        printf 'zengit init: no existe el directorio "%s".\n' "${1:-.}" >&2
        exit 1
    fi
    case "$dir" in
        "$ROOT"/*) ;;
        *) printf 'zengit init: "%s" no esta bajo %s.\n' \
               "${dir/#$HOME/\~}" "${ROOT/#$HOME/\~}" >&2
           exit 1 ;;
    esac
    wt=$dir
    if [ -d "$dir/repo" ]; then
        wt="$dir/repo"
    fi
    slug=$(slug_for "$wt")
    gitdir="$STORE/$slug.git"
    if [ -d "$gitdir" ]; then
        printf 'zengit init: %s ya esta dado de alta (worktree: %s).\n' "$slug" \
            "$(git --git-dir="$gitdir" config --get core.worktree || echo '?')" >&2
        exit 1
    fi
    mkdir -p "$STORE"
    git init -q --bare "$gitdir"
    git --git-dir="$gitdir" config core.bare false
    git --git-dir="$gitdir" config core.worktree "$wt"
    git --git-dir="$gitdir" config core.logallrefupdates true
    printf '%s%s%s dado de alta\n' "$B" "$slug" "$R"
    printf '  %sworktree%s  %s\n' "$D" "$R" "${wt/#$HOME/\~}"
    printf '  %sgit-dir %s  %s\n' "$D" "$R" "${gitdir/#$HOME/\~}"
    printf '  %srama    %s  %s\n' "$D" "$R" \
        "$(git --git-dir="$gitdir" symbolic-ref --short HEAD)"
    printf '\nsiguiente paso:\n  %szengit remote add origin <url-vogsphere>%s\n' "$B" "$R"
}

case "${1:-}" in
    -h|--help) sed -n '2,25p' "$0" | cut -c3-; exit 0 ;;
    -l)        list_repos; exit 0 ;;
    init)      shift; init_repo "$@"; exit 0 ;;
esac

# Sube desde el directorio actual hasta dar con un pack que tenga git-dir.
dir=$(pwd -P)
while [ "$dir" != "/" ]; do
    case "$dir" in
        "$ROOT"/*)
            gitdir="$STORE/$(slug_for "$dir").git"
            if [ -d "$gitdir" ]; then
                # El worktree es el que quedo registrado en el alta, no el
                # directorio desde el que llamas: si no, "zengit add ." desde
                # el pack colaria subject.pdf y test/ en la entrega.
                wt=$(git --git-dir="$gitdir" config --get core.worktree \
                    || printf '%s' "$dir")
                exec git --git-dir="$gitdir" --work-tree="$wt" "$@"
            fi
            ;;
    esac
    dir=$(dirname "$dir")
done

printf 'zengit: no estas dentro de un repo de entrega gestionado.\n' >&2
printf '        situate en un pack bajo %s, o usa "zengit -l".\n' "${ROOT/#$HOME/\~}" >&2
printf '        si es un repo nuevo, dalo de alta con "zengit init".\n' >&2
exit 1
