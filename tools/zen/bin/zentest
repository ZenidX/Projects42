#!/usr/bin/env bash
# zentest - compila y lanza el runner de tests del pack de ejercicios activo.
#
#   zentest              salida completa del runner (caso por caso)
#   zentest --compact    resumen por ejercicio + lista de fallos, para el panel
#   zentest --pack DIR   fuerza un pack concreto en vez del activo
#
# En --compact salen todos los fallos. ZENTEST_KO_MAX=N recorta la lista a N,
# y ZENTEST_CC_MAX=N hace lo propio con los errores de compilacion.
#
# Equivale a `cd <pack>/test && make && ./runner ../repo`, pero cogiendo el
# pack de `zenpack`, asi que al cambiar de pack el panel se reapunta solo.
set -uo pipefail

compact=0
pack=''
while [ $# -gt 0 ]; do
    case $1 in
        -c|--compact) compact=1; shift ;;
        --pack)       pack=${2-}; shift 2 ;;
        -h|--help)    sed -n '2,12p' "$0" | cut -c3-; exit 0 ;;
        *)            printf 'zentest: opcion desconocida %s\n' "$1" >&2; exit 2 ;;
    esac
done

# Bajo `watch -c` la salida es una tuberia pero el color si se pinta, de ahi
# FORCE_COLOR (es lo que usa el panel del layout).
if [ -t 1 ] || [ -n "${FORCE_COLOR-}" ]; then
    B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; RED=$'\033[31m'; Y=$'\033[33m'; R=$'\033[0m'
else
    B=''; D=''; G=''; RED=''; Y=''; R=''
fi

if [ -z "$pack" ]; then
    pack=$(zenpack --print 2>/dev/null) || {
        printf 'Sin pack seleccionado.\nElige uno con %szenpack%s en el panel de la izquierda.\n' "$B" "$R"
        exit 0
    }
fi
name=${pack#"${ZENIDX_ROOT:-$HOME/zenidx/packs}"/}

if [ ! -d "$pack/test" ]; then
    printf '%s%s%s no tiene directorio test/\n' "$B" "$name" "$R"
    exit 0
fi
if [ ! -e "$pack/test/Makefile" ]; then
    printf '%s%s%s: falta test/Makefile\n' "$B" "$name" "$R"
    exit 0
fi

cd "$pack/test"

if ! build=$(make -s 2>&1); then
    printf '%s%s%s  %sno compila el runner%s\n\n%s\n' "$B" "$name" "$R" "$RED" "$R" "$build"
    exit 1
fi

out=$(./runner ../repo 2>&1)

if [ "$compact" -eq 0 ]; then
    printf '%s\n' "$out"
    exit 0
fi

printf '%s\n' "$out" | awk \
    -v name="$name" -v hora="$(date +%H:%M:%S)" -v maxko="${ZENTEST_KO_MAX:-0}" \
    -v maxcc="${ZENTEST_CC_MAX:-12}" \
    -v B="$B" -v D="$D" -v G="$G" -v RED="$RED" -v Y="$Y" -v R="$R" '
/^── / { ex = $2; order[++n] = ex; ok[ex] = 0; ko[ex] = 0; cap = 0; det = 0; next }
/^[[:space:]]*\[OK\]/ { if (ex != "") ok[ex]++; cap = 0; det = 0; next }
/^[[:space:]]*\[KO\]/ {
    if (ex != "") ko[ex]++
    sub(/^[[:space:]]*\[KO\][[:space:]]*/, "")
    fallos[++m] = $0
    cap = 0
    det = m
    next
}
# Un ejercicio puede morir sin emitir un solo [OK]/[KO]: si no compila, si no
# monta el test o si revienta a media tanda. Sin estos cuatro marcadores el
# recuento sale 0 (o parcial) y el ejercicio se pintaba de verde.
/^[[:space:]]*\[COMPILA KO\]/ { if (ex != "") estado[ex] = "compila"; cap = 1; det = 0; next }
/^[[:space:]]*\[TEST KO\]/    { if (ex != "") estado[ex] = "test";    cap = 1; det = 0; next }
/^[[:space:]]*\[SKIP\]/       { if (ex != "") estado[ex] = "skip";    cap = 0; det = 0; next }
# El runner relanza el binario por detras del caso que revienta, asi que un
# crash es un caso mas que falla (con nombre) y el X/total sigue saliendo.
/^[[:space:]]*\[CRASH\]/ {
    if (ex != "") {
        ko[ex]++
        crash[ex] = ($0 ~ /cuelga|timeout/) ? "se cuelga" : "segfault"
    }
    sub(/^[[:space:]]*\[CRASH\][[:space:]]*/, "")
    fallos[++m] = ex ": " $0
    cap = 0
    det = 0
    next
}
# Detras de cada [KO] el runner sangra el detalle (esperado/obtenido). En el
# panel es justo lo que hace falta para saber que estas generando, asi que me lo
# llevo pegado al caso. Dos lineas, que es lo que ocupa un esperado + obtenido.
det && /^[[:space:]]/ && nd[det] < 2 {
    linea = $0
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", linea)
    detalle[det, ++nd[det]] = linea
    next
}
/ejercicios/ { resumen = $0; cap = 0; det = 0; next }
# Tras [COMPILA KO] el runner vuelca el log de cc tal cual. Me quedo con los
# diagnosticos y tiro el eco del fuente y los caret, que en el panel no caben.
cap && /error:|warning:/ {
    linea = $0
    sub(/^[^[:space:]]*\.c:/, "", linea)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", linea)
    ccex[++k] = ex
    cctxt[k] = linea
    next
}
END {
    printf "%s%s%s %s· tests%s%*s%s\n", B, name, R, D, R, 20, hora, R

    for (i = 1; i <= n; i++) {
        ex = order[i]
        st = estado[ex]
        if (ko[ex] > 0 || st == "compila" || st == "test") roto++
    }
    if (resumen != "") {
        col = (roto > 0 ? RED : G)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", resumen)
        printf "%s%s%s\n\n", col, resumen, R
    } else print ""

    for (i = 1; i <= n; i++) {
        ex = order[i]
        tot = ok[ex] + ko[ex]
        st = estado[ex]
        if (st == "compila")    printf "  %-24s %sno compila%s\n", ex, RED, R
        else if (st == "test")  printf "  %-24s %sno monta el test%s\n", ex, RED, R
        else if (st == "skip")  printf "  %-24s %ssin fuente%s\n", ex, Y, R
        else if (tot == 0)      printf "  %-24s %ssin tests%s\n", ex, D, R
        else if (crash[ex])     printf "  %-24s %s%d/%d · %s%s\n", ex, RED, ok[ex],
                                    tot, crash[ex], R
        else if (ko[ex])        printf "  %-24s %s%d/%d%s\n", ex, RED, ok[ex], tot, R
        else                    printf "  %-24s %s%d/%d%s\n", ex, G, ok[ex], tot, R
    }

    if (m > 0) {
        printf "\n  %sfallos%s\n", Y, R
        # Sin tope por defecto: en el panel quiero los fallos enteros, no una
        # muestra. ZENTEST_KO_MAX>0 lo recorta si algun dia molesta el scroll.
        lim = (maxko > 0 && m > maxko) ? maxko : m
        for (i = 1; i <= lim; i++) {
            printf "   %s\n", fallos[i]
            for (j = 1; j <= nd[i]; j++)
                printf "     %s%s%s\n", D, detalle[i, j], R
        }
        if (m > lim) printf "   %s(+%d mas, `zentest` para verlos todos)%s\n", D, m - lim, R
    }

    if (k > 0) {
        printf "\n  %serrores de compilacion%s\n", Y, R
        lim = (k < maxcc ? k : maxcc)
        prev = ""
        for (i = 1; i <= lim; i++) {
            if (ccex[i] != prev) { printf "   %s%s%s\n", B, ccex[i], R; prev = ccex[i] }
            printf "    %s\n", cctxt[i]
        }
        if (k > lim) printf "    %s(+%d mas, `zentest` para verlos todos)%s\n", D, k - lim, R
    }
}'
