#!/usr/bin/env bash
# zenlayout - abre Terminator con el layout de trabajo de zenidx: 3 columnas
# repartidas 1 | 3 | 2 paneles.
#
#   +---------------+-------------+---------------+
#   |               | watch tree  |               |
#   | zenpack       +-------------+ claude        |
#   |   + claude    | norminette  |               |
#   |               +-------------+---------------+
#   |               | watch tests | shell del pack|
#   +---------------+-------------+---------------+
#
#   zenlayout          abre el layout configurado en `zen`
#   zenlayout c04      deja ya elegido ese pack antes de abrir
#   zenlayout -l focus abre un layout concreto sin tocar la configuracion
#
# Los layouts viven en ~/.config/terminator/config bajo [layouts], generados
# por `zen` a partir de la plantilla. Variantes: default, focus, tests, solo.
set -euo pipefail

case "${1-}" in
    -h|--help) sed -n '2,19p' "$0" | cut -c3- ; exit 0 ;;
    -l) [ -n "${2-}" ] || { printf 'zenlayout: -l necesita un nombre de layout\n' >&2; exit 2; }
        exec terminator -l "$2" ;;
esac

if [ $# -gt 0 ]; then
    zenpack "$1"
fi

# El layout activo lo guarda `zen`; si no esta instalado o no hay config,
# cae al de siempre.
layout=$(zen --get layout 2>/dev/null) || layout=default
[ -n "$layout" ] || layout=default

exec terminator -l "$layout"
