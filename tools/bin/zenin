#!/usr/bin/env bash
# zenin - ejecuta un comando dentro del pack de ejercicios activo.
#
#   zenin repo tree            corre `tree` en <pack>/repo
#   zenin repo norminette      corre `norminette` en <pack>/repo
#   zenin . make               corre `make` en la raiz del pack
#
# Pensado para los paneles con `watch`: como lee el pack en cada ejecucion,
# al cambiarlo con `zenpack` los paneles se reapuntan solos.
set -euo pipefail

if [ $# -lt 2 ] || [ "${1-}" = "-h" ] || [ "${1-}" = "--help" ]; then
    sed -n '2,9p' "$0" | cut -c3-
    exit "$([ $# -lt 2 ] && echo 2 || echo 0)"
fi

sub=$1; shift

if ! pack=$(zenpack --print 2>/dev/null); then
    printf 'Sin pack seleccionado.\nElige uno con \033[1mzenpack\033[0m en el panel de la izquierda.\n'
    exit 0
fi

dir="$pack/$sub"
if [ ! -d "$dir" ]; then
    printf '%s no tiene %s/\n' "$(basename "$pack")" "$sub"
    exit 0
fi

cd "$dir"

# ZENIN_HEADER=1 (lo pone zenwatch) antepone una linea con el pack y el subdir,
# para que el panel diga siempre sobre que se esta mirando.
if [ "${ZENIN_HEADER-}" = "1" ]; then
    printf '\033[1m%s\033[0m \033[2m· %s\033[0m\n\n' "${pack#"${ZENIDX_ROOT:-$HOME/zenidx/packs}"/}" "$sub"
fi

exec "$@"
