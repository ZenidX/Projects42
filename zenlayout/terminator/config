[global_config]
  handle_size = 0
  inactive_color_offset = 1.0
[keybindings]
[profiles]
  [[default]]
    cursor_color = "#aaaaaa"
    font = FreeMono Bold 8
    use_system_font = False
    copy_on_selection = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
      size = 2712, 1946
      position = 1128:138
    # --- reparto horizontal: columna A | (columna B | columna C) ---
    [[[child1]]]
      type = HPaned
      parent = window0
      order = 0
      position = 1139
      ratio = 0.42
    # ============ columna A: 1 panel ============
    [[[terminal1]]]
      type = Terminal
      parent = child1
      order = 0
      profile = default
      title = pack
      directory = /home/xalara/zenidx
      command = zenpack; command -v zenshell >/dev/null && exec zenshell repo || exec $SHELL
    [[[child2]]]
      type = HPaned
      parent = child1
      order = 1
      position = 708
      ratio = 0.45
    # ============ columna B: 3 paneles ============
    [[[child3]]]
      type = VPaned
      parent = child2
      order = 0
      position = 648
      ratio = 0.333
    [[[terminal2]]]
      type = Terminal
      parent = child3
      order = 0
      profile = default
      title = tree
      directory = /home/xalara/zenidx
      command = exec zenwatch -n 2 repo tree -C
    [[[child4]]]
      type = VPaned
      parent = child3
      order = 1
      position = 649
      ratio = 0.5
    [[[terminal3]]]
      type = Terminal
      parent = child4
      order = 0
      profile = default
      title = norminette
      directory = /home/xalara/zenidx
      command = exec zenwatch -n 5 repo norminette
    [[[terminal4]]]
      type = Terminal
      parent = child4
      order = 1
      profile = default
      title = tests
      directory = /home/xalara/zenidx
      command = exec zenwatch -H -n 2 test zentest --compact
    # ============ columna C: 2 paneles ============
    [[[child5]]]
      type = VPaned
      parent = child2
      order = 1
      position = 1297
      ratio = 0.666
    [[[terminal5]]]
      type = Terminal
      parent = child5
      order = 0
      profile = default
      title = claude
      directory = /home/xalara/zenidx
      command = claude; exec $SHELL
    [[[terminal6]]]
      type = Terminal
      parent = child5
      order = 1
      profile = default
      title = shell del pack
      directory = /home/xalara/zenidx
      command = command -v zenshell >/dev/null && exec zenshell || exec $SHELL
  [[solo]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
