#!/usr/bin/env bash
# zenlayout - abre Terminator con el layout de trabajo de zenidx: 3 columnas
# repartidas 1 | 3 | 2 paneles.
#
#   +---------------+-------------+---------------+
#   |               | watch tree  |               |
#   | zenpack       +-------------+ claude        |
#   |   + claude    | norminette  |               |
#   |               +-------------+---------------+
#   |               | watch tests | shell del pack|
#   +---------------+-------------+---------------+
#
#   zenlayout          abre el layout; el pack se elige dentro, en el panel
#                      izquierdo, con `zenpack`
#   zenlayout c04      deja ya elegido ese pack antes de abrir
#
# El layout vive en ~/.config/terminator/config bajo [layouts][default], asi
# que `terminator` a secas tambien lo abre. Para una terminal suelta:
# `terminator -l solo`.
set -euo pipefail

case "${1-}" in
    -h|--help) sed -n '2,19p' "$0" | cut -c3- ; exit 0 ;;
esac

if [ $# -gt 0 ]; then
    zenpack "$1"
fi

exec terminator -l default
